INSERT INTO `usuarios_local` VALUES (1,'12','El Guatón de la Fruta'),(2,'10','El Rincón de las Frutas'),(3,'13','El Rey de las Paltas'),(4,'11','El Rincón Urbano'),(8,'15','Tía Sonia'),(9,'14','La Estación de las Frutas'),(10,'09','La Tía Jovi'),(11,'16','El Rincón de las Papas');
