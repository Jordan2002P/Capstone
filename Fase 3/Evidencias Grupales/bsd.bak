DROP TABLE IF EXISTS `usuarios_movimiento`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `usuarios_movimiento` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `cantidad` int unsigned NOT NULL,
  `producto_id` bigint NOT NULL,
  `usuario_id` int NOT NULL,
  `fecha` datetime(6) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `usuarios_movimiento_producto_id_0dc28366_fk_usuarios_producto_id` (`producto_id`),
  KEY `usuarios_movimiento_usuario_id_e49feb0b_fk_auth_user_id` (`usuario_id`),
  CONSTRAINT `usuarios_movimiento_producto_id_0dc28366_fk_usuarios_producto_id` FOREIGN KEY (`producto_id`) REFERENCES `usuarios_producto` (`id`),
  CONSTRAINT `usuarios_movimiento_usuario_id_e49feb0b_fk_auth_user_id` FOREIGN KEY (`usuario_id`) REFERENCES `auth_user` (`id`),
  CONSTRAINT `usuarios_movimiento_chk_1` CHECK ((`cantidad` >= 0))
) ENGINE=InnoDB AUTO_INCREMENT=74 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
